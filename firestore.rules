rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.admin == true; }
  match /questions/{id} {
   allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid','title','body','answer','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80 && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000 && request.resource.data.answer == '' && request.resource.data.createdAt == request.time;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','answeredAt']) && request.resource.data.answer is string && request.resource.data.answer.size() <= 2000 && request.resource.data.answeredAt == request.time;
   allow delete: if admin();
  }
  match /photos/{id} {
   allow read: if resource.data.status == 'approved' || admin() || (signedIn() && resource.data.uid == request.auth.uid);
   allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid','title','path','status','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80 && request.resource.data.path == 'photos/' + request.auth.uid + '/' + id && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','url']) && request.resource.data.status == 'approved' && request.resource.data.url is string;
   allow delete: if admin();
  }
 }
}
